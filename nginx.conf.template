# This file becomes /etc/nginx/conf.d/default.conf
# See template-port-env-subst.sh 

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Who is allowed to tell us the client's address, and in which header.
#
# Every limit_req_zone below keys on $binary_remote_addr. Behind an ALB, which
# terminates the connection, that is the ALB's address, so without this every
# client shares one bucket: /creator/create.json at 1r/m burst=3 means four
# kata creations per minute for everyone, not per user.
#
# The trust boundary is the whole safety argument. nginx believes
# X-Forwarded-For from any peer inside CYBER_DOJO_TRUSTED_PROXY_CIDR, so that
# value must cover the proxies in front of it and nothing else: a client that
# reaches nginx directly from a trusted range can spoof its address and
# sidestep every zone. In ECS the whole private range is trusted, which is no
# weaker than naming the VPC exactly because the tasks' security group admits
# the ALB alone, and it survives any re-addressing of the VPC. Under docker,
# where nginx is itself the edge, it trusts loopback only.
#
# real_ip_recursive stays off (the default): the ALB appends the client address
# as the last X-Forwarded-For entry, which is then what nginx uses. Another
# proxy in front of the ALB would need recursive on and its range trusted too.
set_real_ip_from ${CYBER_DOJO_TRUSTED_PROXY_CIDR};
real_ip_header   X-Forwarded-For;

# Every rate is a variable so a test run can turn it up while exercising this
# same image and template. The production values live in the ports.*.env files
# and are what nginx's own tests assert. Browser tests elsewhere load several
# pages in quick succession, each pulling html plus app.css and app.js through
# one zone, which trips a limit meant for a human at a keyboard.
limit_req_zone $binary_remote_addr zone=creator_create:1m  rate=${CYBER_DOJO_CREATOR_CREATE_RATE};
limit_req_zone $binary_remote_addr zone=creator_enter:1m   rate=${CYBER_DOJO_CREATOR_ENTER_RATE};
limit_req_zone $binary_remote_addr zone=creator_choose:1m  rate=${CYBER_DOJO_CREATOR_CHOOSE_RATE};

limit_req_zone $binary_remote_addr zone=kata_fork:1m       rate=${CYBER_DOJO_KATA_FORK_RATE};
limit_req_zone $binary_remote_addr zone=group_fork:1m      rate=${CYBER_DOJO_GROUP_FORK_RATE};

limit_req_zone $binary_remote_addr zone=kata_file_create:1m  rate=${CYBER_DOJO_KATA_FILE_CREATE_RATE};
limit_req_zone $binary_remote_addr zone=kata_file_delete:1m  rate=${CYBER_DOJO_KATA_FILE_DELETE_RATE};
limit_req_zone $binary_remote_addr zone=kata_file_rename:1m  rate=${CYBER_DOJO_KATA_FILE_RENAME_RATE};
limit_req_zone $binary_remote_addr zone=kata_file_edit:1m    rate=${CYBER_DOJO_KATA_FILE_EDIT_RATE};
limit_req_zone $binary_remote_addr zone=kata_option_set:1m   rate=${CYBER_DOJO_KATA_OPTION_SET_RATE};

limit_req_zone $uri                zone=run_tests:1m        rate=${CYBER_DOJO_RUN_TESTS_RATE};

server {
  listen ${CYBER_DOJO_NGINX_PORT};
  server_name localhost;

  # Use Docker embedded DNS server at 127.0.0.11 if running locally
  # https://stackoverflow.com/questions/35744650/docker-network-nginx-resolver
  resolver ${NGINX_RESOLVER_IP};

  # Path for static files
  root /usr/share/nginx/html;

  client_max_body_size 1G;

  #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  # Home page redirects...

  # Emit relative Location headers so redirects keep the port the client
  # connected on. With absolute_redirect on (the default) nginx builds the
  # Location from server_name and its internal listen port, which drops the
  # published host port when they differ.
  absolute_redirect off;

  # 302 (redirect), not 301 (permanent), for the live entry point: browsers
  # cache a 301 persistently, so a stale one (eg pointing at the wrong port)
  # survives an image change and is painful to evict from every client.
  rewrite ^/$              /creator/home redirect;
  rewrite ^/dojo/index(.*) /creator/home permanent;


  #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  # favicon.ico is in images/ dir for tidyness.

  location = /favicon.ico {
    root /usr/share/nginx/html/images;
  }
  rewrite ^/assets/favicon-(.*).ico /usr/share/nginx/html/images/favicon.ico permanent;

  #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  # Microservices

  # Set services hostnames to force re-resolution of the DNS names
  # https://medium.com/driven-by-code/dynamic-dns-resolution-in-nginx-22133c22e3ab
  set $creator_hostname ${CYBER_DOJO_CREATOR_HOSTNAME};
  set $dashboard_hostname ${CYBER_DOJO_DASHBOARD_HOSTNAME};
  set $saver_hostname ${CYBER_DOJO_SAVER_HOSTNAME};
  set $web_hostname ${CYBER_DOJO_WEB_HOSTNAME};

  # No rewrite in the creator locations: the creator app mounts itself at
  # /creator and serves the path intact.

  # The probes sit outside the rate-limited locations below. Every path under
  # location /creator/ draws on one 60r/m zone, so a probe would spend budget
  # meant for user traffic, and would make that budget depend on how often
  # anything probes.
  location = /creator/alive {
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  location = /creator/ready {
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  location = /creator/status {
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  location = /creator/create.json {
    limit_req zone=creator_create burst=3 nodelay;
    limit_req_status 429;
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  location = /creator/enter.json {
    limit_req zone=creator_enter burst=3 nodelay;
    limit_req_status 429;
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  location /creator/ {
    limit_req zone=creator_choose burst=10 nodelay;
    limit_req_status 429;
    limit_except GET {
      deny all;
    }
    proxy_pass http://$creator_hostname:${CYBER_DOJO_CREATOR_PORT};
  }

  # No rewrite here: the dashboard app mounts itself at /dashboard and serves
  # the path intact. The other prefixed locations below still strip theirs.
  location /dashboard/ {
    limit_except GET {
      deny all;
    }
    proxy_pass http://$dashboard_hostname:${CYBER_DOJO_DASHBOARD_PORT};
  }

  location /saver/ {
    rewrite ^/saver/(.*) /$1 break;
    limit_except GET {
      deny all;
    }
    proxy_pass http://$saver_hostname:${CYBER_DOJO_SAVER_PORT};
  }

  location = /kata/file_create {
    limit_req zone=kata_file_create burst=3 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /kata/file_delete {
    limit_req zone=kata_file_delete burst=3 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /kata/file_rename {
    limit_req zone=kata_file_rename burst=3 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /kata/file_edit {
    limit_req zone=kata_file_edit burst=10 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /kata/option_set {
    limit_req zone=kata_option_set burst=4 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /kata/fork {
    limit_req zone=kata_fork burst=3 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location = /group/fork {
    limit_req zone=group_fork burst=3 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  location ~ ^/kata/run_tests/ {
    limit_req zone=run_tests burst=2 nodelay;
    limit_req_status 429;
    try_files $uri @web;
  }

  #- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  # For everything else try a static file, otherwise try web.

  location / {
    try_files $uri @web;
  }

  location @web {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    proxy_pass http://$web_hostname:${CYBER_DOJO_WEB_PORT};
  }

}
